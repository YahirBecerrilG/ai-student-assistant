generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int           @id @default(autoincrement())
  name          String
  email         String        @unique
  createdAt     DateTime      @default(now())
  tasks         Task[]
  pendingAction PendingAction?
}

model Task {
  id            Int       @id @default(autoincrement())
  userId        Int
  name          String
  category      String
  priority      String
  dateText      String?
  scheduledDate DateTime?
  description   String?
  subject       String?
  estimatedTime Int?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PendingAction {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  action           String
  taskId           Int?
  taskReference    String?
  candidateTaskIds Json?
  updates          Json?
  createdAt        DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}